<h1>New Policy</h1>

<div class="card">
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="/policies">
    <label>Policy Number</label>
    <input type="text" name="policy_number" required autofocus />

    <label>Customer</label>
<select name="customer_id" required>
  <option value="">Select a customer...</option>
  <% for (const c of customers) { %>
    <option value="<%= c.id %>"><%= c.name %></option>
  <% } %>
</select>

    <label>Premium (USD)</label>
    <input type="number" name="premium" step="0.01" min="0" required />

    <label>Start Date</label>
    <input type="date" name="start_date" required />

    <label>End Date</label>
    <input type="date" name="end_date" required />

    <div class="form-actions">
      <button type="submit" class="btn">Create Policy</button>
      <a href="/policies" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>